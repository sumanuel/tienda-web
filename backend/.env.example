# Copia este archivo a .env y completa los valores. NO pongas credenciales reales aquí.

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/tienda_web"

# JWT: usa secretos largos y distintos entre sí, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-este-secreto
JWT_REFRESH_SECRET=cambia-este-otro-secreto
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=4000
NODE_ENV=development
# Número de proxies confiables delante del backend (1 si va detrás del rewrite de
# Next.js o de un balanceador). Necesario para que el límite de intentos use la IP real.
# TRUST_PROXY=1

# Sesión por cookies httpOnly (tsuma_at / tsuma_rt): el navegador debe hablar con la API
# desde el mismo origen que la página (rewrite de Next.js o proxy inverso), así que
# NEXT_PUBLIC_API_URL debe quedar vacío en el frontend. En producción hace falta
# HTTPS (las cookies llevan Secure) y FRONTEND_URL debe coincidir con el origen exacto.

# CORS (en producción es el único origen permitido; varios separados por coma)
FRONTEND_URL="http://localhost:3000"
